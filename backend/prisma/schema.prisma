generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  MANAGER
  RESIDENT
}
model User {
  id String @id @default(uuid()) @db.Uuid
  phone String @unique
  name String
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
  properties Property[]
  assignments ManagerAssignment[]
  allocations Allocation[]
  sessions Session[]
  rentDues RentDue[]
  invitations Invitation[] @relation("Inviter")
}
model Property {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner User @relation(fields: [ownerId], references: [id])
  name String
  address String
  rooms Room[]
  managers ManagerAssignment[]
  rentDues RentDue[]
  monthlyRentPaise Int?
  rentDueDay Int @default(5)
  invitations Invitation[]
  @@index([ownerId])
}
model ManagerAssignment {
  propertyId String @db.Uuid
  managerId String @db.Uuid
  property Property @relation(fields: [propertyId], references: [id])
  manager User @relation(fields: [managerId], references: [id])
  @@id([propertyId, managerId])
  @@index([managerId])
}
model Room {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid
  property Property @relation(fields: [propertyId], references: [id])
  label String
  beds Bed[]
  @@unique([propertyId, label])
}
model Bed {
  id String @id @default(uuid()) @db.Uuid
  roomId String @db.Uuid
  room Room @relation(fields: [roomId], references: [id])
  label String
  allocations Allocation[]
  invitations Invitation[]
  @@unique([roomId, label])
}
model Allocation {
  id String @id @default(uuid()) @db.Uuid
  bedId String @db.Uuid
  residentId String @db.Uuid
  bed Bed @relation(fields: [bedId], references: [id])
  resident User @relation(fields: [residentId], references: [id])
  startedAt DateTime @default(now())
  endedAt DateTime?
  @@index([residentId, endedAt])
  @@index([bedId, endedAt])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId])
}

model Invitation {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid
  inviterId String @db.Uuid
  bedId String? @db.Uuid
  property Property @relation(fields: [propertyId], references: [id])
  inviter User @relation("Inviter", fields: [inviterId], references: [id])
  bed Bed? @relation(fields: [bedId], references: [id])
  phone String
  role Role
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  @@index([propertyId, phone])
}

model RentDue {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid
  residentId String @db.Uuid
  property Property @relation(fields: [propertyId], references: [id])
  resident User @relation(fields: [residentId], references: [id])
  month String
  amountPaise Int
  dueAt DateTime
  createdAt DateTime @default(now())
  payments RentPayment[]
  @@unique([propertyId, residentId, month])
  @@index([residentId, dueAt])
}
model RentPayment {
  id String @id @default(uuid()) @db.Uuid
  rentDueId String @db.Uuid
  rentDue RentDue @relation(fields: [rentDueId], references: [id])
  amountPaise Int
  reference String @unique
  paidAt DateTime @default(now())
  @@index([rentDueId])
}
